{
  "preset_id": "preset_game_isekai",
  "preset_name": "游戏异界·V3.1追读版",
  "preset_description": "游戏异界V3.1追读版：属性面板+打怪升级+技能树成长。系统面板是核心叙事元素，数值成长是爽点来源。",
  "based_on": "preset_fantasy",
  "selections": {
    "node_sentence_rhythm": "opt_rhythm_mixed",
    "node_paragraph_density": "opt_dense_medium",
    "node_dialogue_style": "opt_dialogue_natural",
    "node_description_style": "opt_desc_sensory",
    "node_battle_style": "opt_battle_detail",
    "node_emotion_style": "opt_emotion_both",
    "node_tone": "opt_tone_dramatic",
    "node_platform": "opt_platform_generic",
    "node_info_density": "opt_info_balanced",
    "node_payoff_frequency": "opt_payoff_every_3",
    "node_pov": "opt_pov_limited_third_past",
    "node_rhetoric": "opt_rhetoric_metaphor",
    "node_vocab_sensory": "opt_vocab_fantasy",
    "node_vocab_filler": "opt_filler_webnovel",
    "node_target_length": "opt_length_2800",
    "node_anchor_density": "opt_anchor_dense",
    "node_strictness": "opt_strict_standard",
    "node_ai_creativity": "opt_ai_balanced",
    "node_ai_continue_length": "opt_ai_medium",
    "node_opening_impact": "opt_opening_strong",
    "node_twist_frequency": "opt_twist_standard",
    "node_ending_hook": "opt_hook_break"
  },
  "extra_prompt": "游戏异界V3.1追读版：开篇直接进入游戏事件（穿越/系统激活/第一个任务），禁止世界设定铺垫。属性面板是核心叙事工具，但每章面板展示不超过2次——只在关键升级时刻展示。升级要有仪式感：新技能解锁/属性突破/装备升级的瞬间要有「爽感」。战斗描写要有游戏策略感——技能组合/冷却管理/走位拉扯/仇恨控制。数值成长要合理：不要让主角太快碾压一切，保持挑战性。NPC要有灵魂，不是任务发布机器。禁止纯刷怪流水账：每场战斗都要有叙事目的。章末钩子多样化：升级/新技能/新装备/新线索/新角色/新危机。",
  "extra_constraints": [
    "每章属性面板展示不超过2次，且只在关键升级时刻展示",
    "禁止纯刷怪流水账，每场战斗必须有叙事目的",
    "NPC要有性格和动机，不能是任务发布机器",
    "数值成长要合理，保持挑战性",
    "禁止48个AI套路反应词",
    "章末钩子要多样化，不要只用一种"
  ],
  "extra_rules": [
    {
      "id": "gi-stat-panel-spam",
      "name": "面板过度展示",
      "type": "regex",
      "severity": "info",
      "pattern": "属性面板|属性：|力量：|敏捷：|智力：|等级：|HP：|MP：|技能：|装备：",
      "maxMatches": 8
    }
  ],
  "tags": ["游戏异界", "系统", "升级", "技能", "面板", "公会"],
  "examples": []
