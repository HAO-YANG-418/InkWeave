# ============================================================
# GWE / InkWeave — LLM API 配置
# 复制此文件为 .env 并填入你的 API Key
# ============================================================

# 只需配置一个服务商即可，引擎会自动检测
# 检测顺序: DeepSeek → 豆包(Ark) → OpenAI → 自定义

# ── DeepSeek（推荐，性价比高） ──
# 获取 Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── 豆包 / 火山方舟 ──
# 获取 Key: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
# ARK_API_KEY=your-ark-key-here
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-1-5-pro-32k-250115

# ── OpenAI ──
# 获取 Key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── 自定义（任意 OpenAI 兼容 API） ──
# CUSTOM_API_KEY=your-key-here
# CUSTOM_BASE_URL=https://your-api.com/v1
# CUSTOM_MODEL=your-model-name